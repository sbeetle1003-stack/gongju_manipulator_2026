<?xml version="1.0" ?>
<sdf version='1.10'>
  <model name='aruco_cube'>
    <link name="cube_link">
        <collision name="cube_collision">
            <geometry>
                <box>
                <size>0.05 0.05 0.05</size>
                </box>
            </geometry>

            <surface>
                <friction>
                <ode>
                    <mu>15</mu>
                    <mu2>15</mu2>
                </ode>
                </friction>
            </surface>
        </collision>

        <visual name="cube_visual">
            <geometry>
                <box>
                <size>0.05 0.05 0.05</size>
                </box>
            </geometry>
            <material>
                <ambient>1 1 1 1</ambient>
                <diffuse>1 1 1 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>

        <visual name="aruco_top_visual">
            <pose>0 0 0.0251 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.0001</size>
                </box>
            </geometry>
            <material>
                <ambient>1 1 1 1</ambient>
                <diffuse>1 1 1 1</diffuse>
                <pbr>
                    <metal>
                        <albedo_map>
                            material/textures/aruco_0.png
                        </albedo_map>
                        <roughness>1.0</roughness>
                        <metalness>0.0</metalness>
                    </metal>
                </pbr>
            </material>
        </visual>

    </link>
  </model>
</sdf>